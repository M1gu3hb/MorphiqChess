{
  "name": "morphiqchess",
  "private": true,
  "version": "0.1.0",
  "description": "MorphiqChess: ajedrez con el tablero y las piezas de Morphiq. Dos jugadores en un dispositivo, entrenamiento de aperturas y práctica contra doce rivales.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "training:convert": "vite build --config tools/training/vite.config.ts && node node_modules/.cache/training-convert/run.js",
    "verify": "npm run typecheck && npm run test && vite build",
    "bots:duel": "vite build --config tools/bots/vite.config.ts && node node_modules/.cache/bots-duel/duel.js",
    "bots:fit": "node tools/bots/fit.ts"
  },
  "dependencies": {
    "@fontsource-variable/exo-2": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chess.js": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
